# Copy to .env and adjust if you change the Compose defaults.
# None of these are real secrets — local dev only.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=encore
POSTGRES_PASSWORD=encore_dev_only
POSTGRES_DB=encore

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Rate limiter (Week 4) — global per-IP limits
RATE_LIMIT_GLOBAL_CAPACITY=10
RATE_LIMIT_GLOBAL_PER_SECOND=1.6667

# Rate limiter — per-user checkout limits
RATE_LIMIT_CHECKOUT_CAPACITY=1
RATE_LIMIT_CHECKOUT_PER_SECOND=0.05

# Snowflake ID generator worker ID (0-1023, must be unique per process in multi-process deployments)
SNOWFLAKE_WORKER_ID=0

# Waiting room (Week 6) — comma-separated flash-sale event UUIDs
# Leave empty to disable waiting room for all events
FLASH_SALE_EVENT_IDS=

# Waiting room admission settings
ADMISSION_BATCH_SIZE=100
ADMISSION_INTERVAL_SECS=5
ADMISSION_TOKEN_TTL_SECS=600

# Inventory Core (Week 7)
HOLD_TTL_MINUTES=5.0
EXPIRY_POLL_INTERVAL_SECS=60
EXPIRY_ADVISORY_LOCK_ID=1001

# MinIO (Week 21) - S3 compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Auth (Week 24)
JWT_SECRET_KEY=change-me-in-production
JWT_TTL_SECONDS=86400

# MinIO / Object Storage
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Internal service URLs
PAYMENT_SERVICE_URL=http://localhost:8002
LOCATION_SERVICE_URL=http://localhost:8004
SCHEDULER_SERVICE_URL=http://localhost:8005
DEPLOYMENT_SERVICE_URL=http://localhost:8006
WALLET_SERVICE_URL=http://localhost:8007
API_GATEWAY_URL=http://localhost:8000

# Read/Write DB split
POSTGRES_WRITE_DB=encore
POSTGRES_READ_DB=encore
POSTGRES_SHARD_URLS=postgresql+psycopg2://encore:encore_dev_only@localhost:5432/shard_0,postgresql+psycopg2://encore:encore_dev_only@localhost:5432/shard_1,postgresql+psycopg2://encore:encore_dev_only@localhost:5432/shard_2

# Observability
OTLP_ENDPOINT=http://localhost:4317
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
