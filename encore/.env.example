# Copy to .env and adjust if you change the Compose defaults.
# None of these are real secrets — local dev only.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=encore
POSTGRES_PASSWORD=encore_dev_only
POSTGRES_DB=encore

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Rate limiter (Week 4) — global per-IP limits
RATE_LIMIT_GLOBAL_CAPACITY=10
RATE_LIMIT_GLOBAL_PER_SECOND=1.6667

# Rate limiter — per-user checkout limits
RATE_LIMIT_CHECKOUT_CAPACITY=1
RATE_LIMIT_CHECKOUT_PER_SECOND=0.05

# Snowflake ID generator worker ID (0-1023, must be unique per process in multi-process deployments)
SNOWFLAKE_WORKER_ID=0

# Waiting room (Week 6) — comma-separated flash-sale event UUIDs
# Leave empty to disable waiting room for all events
FLASH_SALE_EVENT_IDS=

# Waiting room admission settings
ADMISSION_BATCH_SIZE=100
ADMISSION_INTERVAL_SECS=5
ADMISSION_TOKEN_TTL_SECS=600
