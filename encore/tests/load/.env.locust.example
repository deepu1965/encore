TEST_USER_TOKEN=

# Scenario A — Contention correctness test
CONTENTION_EVENT_ID=
CONTENTION_SEAT_ID=

# Scenario B — Flash sale throughput test
FLASH_SALE_EVENT_ID=
FLASH_SALE_SEAT_IDS=

IDEMPOTENCY_PREFIX=locust-test
