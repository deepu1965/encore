# Encore frontend environment (copy to .env.local)

# --- Core origins ---
# API gateway (mounts events/holds/orders/payments/search/chat/... — see Phase 0 report)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# WebSocket gateway base (chat WS lives here today — gap G-10)
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws

NEXT_PUBLIC_ENVIRONMENT=development

# Optional
NEXT_PUBLIC_MAPTILE_URL=
NEXT_PUBLIC_SENTRY_DSN=

# --- Per-service origins (Phase 0 gap G-9) ---
# The api-gateway does NOT proxy these services. Set them if they run on
# separate origins; leave unset to fall back to NEXT_PUBLIC_API_BASE_URL
# (single-origin / future gateway-proxy deployments).
NEXT_PUBLIC_RESALE_BASE_URL=
NEXT_PUBLIC_WAITING_ROOM_BASE_URL=
NEXT_PUBLIC_WALLET_BASE_URL=
NEXT_PUBLIC_NOTIFICATION_BASE_URL=
